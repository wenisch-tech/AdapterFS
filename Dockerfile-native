# syntax=docker/dockerfile:1.28
FROM maven:3.10.0-eclipse-temurin-25 AS maven-bin

FROM ghcr.io/graalvm/native-image-community:25 AS builder
WORKDIR /workspace

COPY --from=maven-bin /usr/share/maven /usr/share/maven
COPY --from=maven-bin /usr/bin/mvn /usr/bin/mvn
ENV MAVEN_HOME=/usr/share/maven
ENV PATH="${MAVEN_HOME}/bin:${PATH}"

COPY pom.xml ./
COPY src src
RUN --mount=type=cache,target=/root/.m2 mvn -B -Pnative -DskipTests package

FROM cgr.dev/chainguard/glibc-dynamic:latest
WORKDIR /app
ARG BUILD_DATE
ARG BUILD_VERSION=dev
ARG BUILD_REVISION
LABEL org.opencontainers.image.title="AdapterFS Native" \
      org.opencontainers.image.source="https://github.com/wenisch-tech/AdapterFS" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.revision="${BUILD_REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}"
COPY --from=builder --chown=65532:65532 /workspace/target/adapterfs /app/adapterfs
COPY --chown=65532:65532 docker/state/ /var/lib/adapterfs/
EXPOSE 8080 9000 2222 2121 30000-30009
ENTRYPOINT ["/app/adapterfs"]
